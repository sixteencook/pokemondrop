# Copier ce fichier vers `.env` puis remplir les valeurs.

# Token du bot Telegram (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID du destinataire principal (obtenu via @userinfobot ou l'API getUpdates)
TELEGRAM_CHAT_ID=

# Destinataires supplémentaires, séparés par des virgules (groupe privé,
# second compte…). Chaque ID reçoit la même alerte.
# Exemple : TELEGRAM_CHAT_IDS=-100123456789,987654321
TELEGRAM_CHAT_IDS=

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Dossier des données persistantes (SQLite, captures).
# En conteneur : /data (volume). Déjà positionné par l'image Docker.
DATA_DIR=data

# Dossier des fichiers de logs. Les logs restent aussi sur stdout
# (capté par Railway / docker logs).
LOG_DIR=logs

# URL de base de données. Par défaut : SQLite dans DATA_DIR.
# Pour PostgreSQL plus tard : postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=

# --- Dashboard web -----------------------------------------------------------
# Port d'écoute du serveur (défaut : 8000). Sur Railway, la variable est
# injectée automatiquement — ne pas la définir.
# PORT=8000

# Identifiants de connexion au dashboard (OBLIGATOIRES pour utiliser l'API).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Clé de signature des sessions (JWT). Générer par exemple avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Durée de vie d'une session, en heures (défaut : 24).
# AUTH_TOKEN_TTL_HOURS=24

# --- Captures d'écran (Playwright) ------------------------------------------
# Nécessite : pip install playwright && playwright install chromium
SCREENSHOTS_ENABLED=true

# Délai maximal de chargement + capture d'une page, en millisecondes.
SCREENSHOT_TIMEOUT=20000

# Qualité 1-100. Le PNG étant sans perte, la valeur pilote la densité de
# rendu (>= 80 → capture 2x « retina »). Appliquée à l'encodeur si
# SCREENSHOT_FORMAT=jpeg.
SCREENSHOT_QUALITY=90

# Captures simultanées maximales (mémoire : ~200 Mo par capture).
SCREENSHOT_MAX_CONCURRENT=2

# Conservation des captures, en jours (0 = illimité).
SCREENSHOT_RETENTION_DAYS=90

# Options avancées :
# SCREENSHOT_FORMAT=png          # png | jpeg
# SCREENSHOT_FULL_PAGE=true      # page entière ou seulement la zone visible
# SCREENSHOT_SETTLE_DELAY=400    # ms d'attente après chargement (stabilité)
# SCREENSHOT_MAX_ATTEMPTS=2      # tentatives par capture
# SCREENSHOTS_DIR=               # défaut : <DATA_DIR>/screenshots
